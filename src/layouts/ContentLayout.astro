---
import { ClientRouter } from 'astro:transitions'
import type { ImageMetadata } from 'astro'
import '../styles/global.css'
import Menu from '../components/Menu.astro'
import Metadata from '../components/Metadata.astro'
import SplashImage from '../components/SplashImage.astro'

interface Props {
  title?: string
  description?: string
  splashImage?: ImageMetadata
  prefetchLinks?: string[]
  preloadImages?: string[]
}

const { title, description, splashImage, prefetchLinks, preloadImages } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="favicon.jpg" />
    <Metadata title={title} description={description} image={splashImage} />
    {prefetchLinks?.map((href) => <link rel="prefetch" href={href} />)}
    {preloadImages?.map((href) => <link rel="preload" as="image" href={href} />)}
    <ClientRouter />
  </head>
  <body>
    <div class="max-w-3xl m-auto py-3 px-3 lg:px-0 overflow-hidden">
      <Menu />
      {splashImage && <SplashImage src={splashImage} />}
      <main><slot /></main>
      <script is:inline>
        (() => {
          const endpoint = '/api/session/nav'
          // Keep one shared logger state across client-side navigations.
          const globalState = (window.__sessionNavLogState ??= {
            // Prevent attaching duplicate event listeners after page swaps.
            installed: false,
            // Used to suppress accidental duplicate logs fired in quick succession.
            lastPath: '',
            lastLoggedAt: 0
          })

          const logPath = () => {
            const path = `${window.location.pathname}${window.location.search}${window.location.hash}`
            const now = Date.now()

            // Skip immediate duplicate path logs (e.g. overlapping lifecycle events).
            if (path === globalState.lastPath && now - globalState.lastLoggedAt < 250) {
              return
            }

            globalState.lastPath = path
            globalState.lastLoggedAt = now

            void fetch(endpoint, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ path }),
              keepalive: true
            }).catch(() => {})
          }

          if (!globalState.installed) {
            document.addEventListener('astro:after-swap', logPath)
            globalState.installed = true
          }

          logPath()
        })()
      </script>
      <script is:inline src="/js/image-enlarge.js"></script>
    </div>
  </body>
</html>
