{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jldec-astro",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-03-29",
  "account_id": "a0b19134b3f8f7aaae377202538aafe3",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/sessions", "/api/*"]
  },
  "observability": {
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionStoreDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionStoreDO"]
    }
  ]
}
